rules_version = '2';

// DevSync multi-tenant RBAC security model
// - Every tenant lives under /workspaces/{workspaceId}. Access is granted only when the caller's
//   uid is a key of that workspace's `members` map with a locked role ('owner', 'team_member', 'developer').
// - Feed updates, webhook logs, installation links and GitHub metadata are written exclusively by
//   Cloud Functions (Admin SDK bypasses rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function wsData(wsId) {
      return get(/databases/$(database)/documents/workspaces/$(wsId)).data;
    }

    function isMember(wsId) {
      return signedIn() && request.auth.uid in wsData(wsId).members;
    }

    function roleIn(wsId) {
      return wsData(wsId).members[request.auth.uid];
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function isStr(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // Per-user index of workspace IDs. Joining someone else's workspace goes through the
    // joinWorkspace function; listing an ID you are not a member of grants nothing.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['workspaceIds'])
        && request.resource.data.workspaceIds is list
        && request.resource.data.workspaceIds.size() <= 50;
    }

    // installationId -> workspaceId mapping. Server only.
    match /installations/{installationId} {
      allow read, write: if false;
    }

    // 6-character role-locked invite tokens. Joining goes through joinWorkspace Cloud Function.
    match /invites/{code} {
      allow read: if isMember(resource.data.workspaceId);
      allow create: if signedIn()
        && isMember(request.resource.data.workspaceId)
        && request.resource.data.keys().hasOnly(['code', 'workspaceId', 'workspaceName', 'role', 'createdBy', 'usedBy', 'createdAt'])
        && request.resource.data.code == code
        && request.resource.data.code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.role in ['owner', 'team_member', 'developer']
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.usedBy == null
        && request.resource.data.createdAt == request.time
        && roleIn(request.resource.data.workspaceId) in ['owner', 'developer'];
      allow delete: if isMember(resource.data.workspaceId)
        && (roleIn(resource.data.workspaceId) == 'owner' || resource.data.createdBy == request.auth.uid);
      allow update: if false;
    }

    match /workspaces/{wsId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'name', 'ownerId', 'members', 'profiles', 'inviteCode', 'ticketCounter',
          'github', 'businessProfile', 'workspaceLinks', 'deletionRequest', 'createdAt'
        ])
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.profiles.keys().hasOnly([request.auth.uid])
        && (
          (request.resource.data.members[request.auth.uid] == 'owner' && request.resource.data.ownerId == request.auth.uid)
          || (request.resource.data.members[request.auth.uid] == 'developer' && request.resource.data.ownerId == null)
        )
        && isStr(request.resource.data.name, 2, 60)
        && request.resource.data.ticketCounter == 0
        && request.resource.data.github == null
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn() && request.auth.uid in resource.data.members && (
        // owner can update business metadata, links, and deletion request resolution
        (resource.data.members[request.auth.uid] == 'owner'
          && onlyChanges(['name', 'businessProfile', 'workspaceLinks', 'deletionRequest'])
          && isStr(request.resource.data.name, 2, 60))
        // developer can submit/clear a deletion request when an owner exists
        || (resource.data.members[request.auth.uid] == 'developer'
          && onlyChanges(['deletionRequest']))
        // any member can allocate the next ticket number (inside the createTicket transaction)
        || (onlyChanges(['ticketCounter']) && request.resource.data.ticketCounter == resource.data.ticketCounter + 1)
      );

      allow delete: if signedIn() && (
        resource.data.members[request.auth.uid] == 'owner'
        || (resource.data.members[request.auth.uid] == 'developer' && resource.data.ownerId == null)
      );

      match /members/{memberUid} {
        allow read: if isMember(wsId);
        allow create: if signedIn()
          && request.auth.uid == memberUid
          && request.auth.uid in getAfter(/databases/$(database)/documents/workspaces/$(wsId)).data.members
          && request.resource.data.role == getAfter(/databases/$(database)/documents/workspaces/$(wsId)).data.members[request.auth.uid];
        allow update: if isMember(wsId)
          && roleIn(wsId) == 'owner'
          && memberUid != request.auth.uid
          && request.resource.data.role in ['owner', 'team_member', 'developer'];
        allow delete: if isMember(wsId)
          && roleIn(wsId) == 'owner'
          && memberUid != request.auth.uid;
      }

      match /updates/{updateId} {
        allow read: if isMember(wsId);
        allow create, delete: if false;
        allow update: if isMember(wsId) && (
          (onlyChanges(['reactions', 'commentCount'])
            && request.resource.data.reactions.keys().hasOnly(['👍', '🚀', '❤️', '👀'])
            && request.resource.data.commentCount - resource.data.commentCount in [0, 1])
          || (roleIn(wsId) == 'owner'
            && onlyChanges(['approvalStatus', 'approvedBy', 'approvedAt', 'approvalNote'])
            && request.resource.data.approvalStatus in ['pending', 'approved', 'changes_requested'])
        );

        match /comments/{commentId} {
          allow read: if isMember(wsId);
          allow create: if isMember(wsId)
            && request.resource.data.keys().hasOnly(['text', 'parentId', 'authorId', 'authorName', 'authorPhoto', 'authorRole', 'createdAt'])
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.authorRole == roleIn(wsId)
            && isStr(request.resource.data.text, 1, 2000)
            && isStr(request.resource.data.authorName, 1, 100)
            && (request.resource.data.parentId == null || request.resource.data.parentId is string)
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }
      }

      match /tickets/{ticketId} {
        allow read: if isMember(wsId);
        allow create: if isMember(wsId)
          && request.resource.data.keys().hasOnly([
            'number', 'title', 'description', 'priority', 'kind', 'milestoneId',
            'status', 'createdBy', 'linkedCommit', 'activity', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.number == getAfter(/databases/$(database)/documents/workspaces/$(wsId)).data.ticketCounter
          && request.resource.data.createdBy.uid == request.auth.uid
          && isStr(request.resource.data.title, 1, 120)
          && isStr(request.resource.data.description, 0, 4000)
          && request.resource.data.priority in ['low', 'medium', 'high']
          && (
            (roleIn(wsId) == 'team_member' && request.resource.data.kind == 'suggestion')
            || (roleIn(wsId) in ['owner', 'developer'] && request.resource.data.kind in ['change_request', 'suggestion'])
          )
          && request.resource.data.status == 'todo'
          && request.resource.data.linkedCommit == null
          && request.resource.data.activity.size() == 1
          && request.resource.data.createdAt == request.time;

        allow update: if isMember(wsId)
          && roleIn(wsId) == 'developer'
          && onlyChanges(['status', 'linkedCommit', 'milestoneId', 'activity', 'updatedAt'])
          && request.resource.data.status in ['todo', 'in_progress', 'completed']
          && request.resource.data.activity.size() >= resource.data.activity.size()
          && request.resource.data.activity.size() <= 200
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /milestones/{milestoneId} {
        allow read: if isMember(wsId);
        allow create, delete: if isMember(wsId) && roleIn(wsId) == 'owner';
        allow update: if isMember(wsId) && (
          roleIn(wsId) == 'owner'
          || (roleIn(wsId) == 'developer'
            && onlyChanges(['progress', 'status', 'linkedUpdateIds', 'linkedTicketIds', 'updatedAt'])
            && request.resource.data.progress is number
            && request.resource.data.progress >= 0
            && request.resource.data.progress <= 100
            && request.resource.data.status in ['planned', 'in_progress', 'completed'])
        );
      }

      match /weeklyDigests/{digestId} {
        allow read: if isMember(wsId);
        allow write: if false;
      }

      match /webhookLogs/{logId} {
        allow read: if isMember(wsId) && roleIn(wsId) == 'developer';
        allow write: if false;
      }
    }
  }
}
