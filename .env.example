# Leave the VITE_FIREBASE_* values empty to run DevSync in local Demo Mode
# (localStorage + cross-tab real-time sync, no backend required).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Connect the web app to the local Firebase emulators (npm run emulators)
VITE_USE_EMULATORS=false

# Show the "Simulate GitHub event" tool in Developer View when using Firebase.
# Must be paired with ALLOW_SIMULATION=true in functions/.env
VITE_ENABLE_SIMULATOR=false
