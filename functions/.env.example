# Copy to functions/.env (non-secret parameters)
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=devsync-app
GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
APP_URL=http://localhost:5173
GEMINI_MODEL=gemini-2.5-flash
# Enables the "Simulate webhook" callable (testing only)
ALLOW_SIMULATION=false
# Send code diffs (truncated, lockfiles/binaries excluded) to Gemini for better summaries
AI_INCLUDE_DIFFS=true
