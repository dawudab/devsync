# Copy to functions/.secret.local for the emulator ONLY. In production use:
#   firebase functions:secrets:set GITHUB_PRIVATE_KEY < private-key.pem
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
STATE_SECRET=
# Set to "disabled" to use the built-in heuristic translator instead of Gemini
GEMINI_API_KEY=disabled
